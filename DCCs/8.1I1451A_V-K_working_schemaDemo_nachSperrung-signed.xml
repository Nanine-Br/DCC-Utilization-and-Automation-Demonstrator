	<dcc:measurementResults>
		<dcc:measurementResult>
			<dcc:name>
				<dcc:content lang="de">Kalibrierung eines Widerstandsthermometers</dcc:content>
				<dcc:content lang="en">Calibration of a resistance thermometer</dcc:content>
			</dcc:name>
			<dcc:usedMethods>
				
				<dcc:usedMethod refType="temp_calibrationMethod">
					<dcc:name>
						<dcc:content lang="de">Kalibrierverfahren</dcc:content>
						<dcc:content lang="en">Calibration procedure</dcc:content>
					</dcc:name>
					<dcc:description>
						<dcc:content lang="de">	Die Kalibrierung erfolgte gemäß DKD-R 5-1: 2018-09 im Vergleichsverfahren.</dcc:content>
						<dcc:content lang="en"> According to DKD-R 5-1: 2018-09, the object was calibrated comparing the indicated values 
												of the calibration object and the values from the reference thermometer.</dcc:content>
					</dcc:description>
					<dcc:norm>DKD-R 5-1:2018-09</dcc:norm>
				</dcc:usedMethod>
				<dcc:usedMethod refType="temp_conversionProcedure">
					<dcc:name>
						<dcc:content lang="de">Umrechnungsvorschrift</dcc:content>
						<dcc:content lang="en">Conversion procedure</dcc:content>
					</dcc:name>
					<dcc:description>
						<dcc:content lang="de">	Aus den gemessenen Widerstandswerten wurden die entsprechenden Temperaturwerte
												gemäß DIN EN 60751 ermittelt und den Temperatur-Referenzwerten gegenübergestellt.</dcc:content>
						<dcc:content lang="en"> Temperatur values assigned to the measured resistance values  
												according to DIN EN 60751 are represented and compared to the reference values.</dcc:content>
					</dcc:description>
					<dcc:norm>DIN EN 60751</dcc:norm>
				</dcc:usedMethod>
				<dcc:usedMethod id="selfHeating" refType="temp_selfHeatingDetermination">
					
					<dcc:name>
						<dcc:content lang="de">Bestimmung der Eigenerwärmung</dcc:content>
						<dcc:content lang="en">Determination of self-heating</dcc:content>
					</dcc:name>
					<dcc:description>
						<dcc:content lang="de">	Der Einfluss der Eigenerwärmung für den Temperaturfühler wurde nicht untersucht.
												Er kann einen zusätzlichen Messunsicherheitsbeitrag von bis zu 30 mK (k=2) liefern.
												Dieser Beitrag ist in der angegebenen erweiterten Messunsicherheit enthalten.</dcc:content>
						<dcc:content lang="en"> The influence of self-heating for the thermal sensor was not investigated.
												It can provide an additional measurement uncertainty contribution of up to 30 mK (k=2).
												This contribution is included in the expanded measurement uncertainty.</dcc:content>
					</dcc:description>
					<dcc:norm>DKD-R 5-1:2018-09</dcc:norm>
				</dcc:usedMethod>
				<dcc:usedMethod id="measuringCurrent" refType="temp_measuringCurrent">
					
					<dcc:name>
						<dcc:content lang="de">Verwendeter Messstrom</dcc:content>
						<dcc:content lang="en">Measuring current used</dcc:content>
					</dcc:name>
					<dcc:description>
						<dcc:content lang="de">Der Messstrom bei der Widerstandsmessung (Ieff) betrug 0,7 mA.</dcc:content>
						<dcc:content lang="en">The current (RMS) during the resistance measurement was 0,7 mA.</dcc:content>
					</dcc:description>
					<dcc:norm>DKD-R 5-1:2018-09</dcc:norm>
				</dcc:usedMethod>
				<dcc:usedMethod id="hysteresis" refType="temp_hysteresisDetermination">
					
					<dcc:name>
						<dcc:content lang="de">Bestimmung der Hysterese</dcc:content>
						<dcc:content lang="en">Hysteresis determination</dcc:content>
					</dcc:name>
					<dcc:description>
						<dcc:content lang="de">	Der Einfluss der Hysterese wurde experimentell nicht ermittelt.
												Es ist davon auszugehen, dass dieser im Temperaturbereich der Kalibrierung bis zu 0.028 K betragen kann,	
												sofern die Messungen nicht durchgehend in der angegebenen Temperaturmesspunkt-Reihenfolge durchgeführt werden.
												Dabei ist der größte Einfluss in der Mitte des Temperaturbereichs zu erwarten.
												Die Hysterese ist in der ausgewiesenen Messunsicherheit nicht berücksichtigt.</dcc:content>
						<dcc:content lang="en"> The influence of the hysteresis was not determined experimentally, it is expected to have an additional contribution 
												of up to 0.028 K to the measurement uncertainty, for the temperature range of this calibration, 
												in case the measurements are not performed in the same order of temperature setpoints. 
												The lagest contribution is expected to be in the center of the temperature range.
												The hysteresis is not considered in the measurement uncertainty stated.</dcc:content>
					</dcc:description>
					<dcc:norm>DKD-R 5-1:2018-09</dcc:norm>
				</dcc:usedMethod>
				<dcc:usedMethod refType="temp_thermostatUsed">
					<dcc:name>
						<dcc:content>Thermostat</dcc:content>
					</dcc:name>
					<dcc:description>
						<dcc:content lang="de">Die Kalibrierung wurde in einem gerührtes Flüssigkeitsthermostat durchgeführt.</dcc:content>
						<dcc:content lang="en">The calibration was carried out in a stirred liquid bath.</dcc:content>
					</dcc:description>
					<dcc:norm>DKD-R 5-1:2018-09</dcc:norm>
				</dcc:usedMethod>
				<dcc:usedMethod id="totalSampleTime" refType="temp_totalSampleTime">
					<dcc:name>
						<dcc:content lang="de">Gesamtaufnahmezeit pro Temperatur</dcc:content>
						<dcc:content lang="en">Total recording time per temperature</dcc:content>
					</dcc:name>
					<dcc:description>
						<dcc:content lang="de">	Die Messungen erfolgten, nach Temperaturstabilisierung am jeweiligen Kalibrierpunkt, über einen Zeitraum von 10 Minuten.</dcc:content>
						
						<dcc:content lang="en"> The measurements were made after temperature stabilization at the respective calibration point, over a period of 10 minutes.</dcc:content>
					</dcc:description>
				</dcc:usedMethod>
				<dcc:usedMethod id="numberOfSamples" refType="temp_numberOfSamples">
					<dcc:name>
						<dcc:content lang="de">Anzahl der Einzelmessungen des Kalibriergegenstandes pro Temperatur</dcc:content>
						<dcc:content lang="en">Number of individual measurements of the DUT for each temperature</dcc:content>
					</dcc:name>
					<dcc:description>
						<dcc:content lang="de">	Die angegebenen Messwerte stellen jeweils einen Mittelwert aus 50 Einzelmessungen dar.</dcc:content>
						
						<dcc:content lang="en"> The stated Temperature values represent a mean from 50 single measurements.</dcc:content>
						
					</dcc:description>
				</dcc:usedMethod>
				<dcc:usedMethod refType="basic_uncertainty">
					<dcc:name>
						<dcc:content lang="de">Messunsicherheit</dcc:content>
						<dcc:content lang="en">Measurement uncertainty</dcc:content>
					</dcc:name>
					<dcc:description>
						<dcc:content lang="de"> Angegeben ist die erweiterte Messunsicherheit, die sich aus der Standardmessunsicherheit 
												durch Multiplikation mit dem Erweiterungsfaktor k=2 ergibt. Sie wurde gemäß dem EA-4/02 M:2022 ermittelt. 
												Der Wert der Messgröße liegt mit einer Wahrscheinlichkeit von 95 % im zugeordneten Werteintervall.</dcc:content>
						<dcc:content lang="en"> The reported expanded uncertainty is stated as the standard uncertainty multiplied by a coverage factor k=2. 
												The coverage factor k=2 for a normal distribution corresponds to a coverage probability of approx. 95 %.</dcc:content>
					</dcc:description>
					<dcc:norm>EA-4/02 M:2022</dcc:norm>
				</dcc:usedMethod>
			</dcc:usedMethods>
